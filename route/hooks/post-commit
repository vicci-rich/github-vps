#!/bin/sh
# Route backend: write the signed envelope for the commit that was just made.
# Never fails the git operation.
bin="${ROUTE_BIN:-}"
if [ -z "$bin" ]; then bin=$(git config --get route.bin 2>/dev/null || true); fi
if [ -z "$bin" ]; then bin=$(command -v route 2>/dev/null || true); fi
[ -z "$bin" ] && exit 0
[ -x "$bin" ] || exit 0
"$bin" envelope HEAD >/dev/null 2>&1 || exit 0
exit 0
